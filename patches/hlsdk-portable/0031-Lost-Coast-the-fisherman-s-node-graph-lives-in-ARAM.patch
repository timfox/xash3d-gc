From 7522ae20521077f9c7b7a649480eb355a84d3fca Mon Sep 17 00:00:00 2001
From: timfox <timfox@outlook.com>
Date: Thu, 19 Nov 2026 18:06:25 -0800
Subject: [PATCH] Lost Coast: the fisherman's node graph lives in ARAM

The heap no longer has 8 KB in one piece when he spawns, so the graph
file failed to load and he walked every route in a straight line. It is
kept in ARAM (GC_GameFileToAram) and read back onto the stack when a
route is worked out. 'body' events set and clear bits.

---
 dlls/lostcoast_npcs.cpp | 82 +++++++++++++++++++++++++++++++++++------
 1 file changed, 71 insertions(+), 11 deletions(-)

diff --git a/dlls/lostcoast_npcs.cpp b/dlls/lostcoast_npcs.cpp
index 66b19694..03862517 100644
--- a/dlls/lostcoast_npcs.cpp
+++ b/dlls/lostcoast_npcs.cpp
@@ -335,13 +335,31 @@ static lc_scene_t	g_lcScenes[LC_MAX_SCENES];
 static lc_event_t	g_lcEvents[LC_EVENT_POOL];
 static int		g_lcNumEvents;
 static int		g_lcNumScenes;
-// The node graph is used where its file was loaded: arrays of their own
-// were 8 KB more of static data beside the 8 KB file, and the GameCube heap
-// has not had both since the talker's scenes grew (the file's floats and
-// shorts are big-endian, the console's own order; other hosts swap in place).
+// The node graph has no memory of its own. On the GameCube its file lives
+// in ARAM (the heap does not have 8 KB in one piece when he spawns, and
+// static arrays come out of the same heap), and a route is worked out on a
+// copy read back onto the stack. Elsewhere the loaded file is used in place.
+// The file's floats and shorts are big-endian, the console's own order;
+// other hosts swap in place.
+#define LC_GRAPH_MAX	8192	// bytes of file
+static int		g_lcNumNodes, g_lcNumLinks;
 static float		(*g_lcNodes)[3];
 static unsigned short	(*g_lcLinks)[2];
-static int		g_lcNumNodes, g_lcNumLinks;
+static unsigned int	g_lcGraphAram;
+static int		g_lcGraphLen;
+extern "C" unsigned int GC_GameFileToAram( const char *path, int *len ) __attribute__(( weak ));
+extern "C" void GC_GameAramRead( unsigned int aram, void *dst, int bytes ) __attribute__(( weak ));
+
+// buf: LC_GRAPH_MAX + 32 bytes, 32-byte aligned.
+static void LC_GraphOpen( byte *buf )
+{
+	if( g_lcGraphAram && GC_GameAramRead )
+	{
+		GC_GameAramRead( g_lcGraphAram, buf, g_lcGraphLen );
+		g_lcNodes = (float (*)[3])( buf + 8 );
+		g_lcLinks = (unsigned short (*)[2])( buf + 8 + g_lcNumNodes * 12 );
+	}
+}
 
 static float LC_Approach( float target, float value, float speed )
 {
@@ -457,6 +475,30 @@ static void LC_LoadNodes( const char *file )
 
 	if( g_lcNumNodes )
 		return;
+	if( GC_GameFileToAram && GC_GameAramRead )
+	{
+		byte head[32] __attribute__(( aligned( 32 )));
+
+		g_lcGraphAram = GC_GameFileToAram( file, &g_lcGraphLen );
+		if( g_lcGraphAram && g_lcGraphLen >= 8 && g_lcGraphLen <= LC_GRAPH_MAX )
+		{
+			GC_GameAramRead( g_lcGraphAram, head, 8 );
+			if( !memcmp( head, "LCNG", 4 ))
+			{
+				int nn = ( head[4] << 8 ) | head[5], nl = ( head[6] << 8 ) | head[7];
+
+				if( nn <= LC_MAX_NODES && nl <= LC_MAX_LINKS && 8 + nn * 12 + nl * 4 <= g_lcGraphLen )
+				{
+					g_lcNumNodes = nn;
+					g_lcNumLinks = nl;
+				}
+			}
+		}
+		if( !g_lcNumNodes )
+			g_lcGraphAram = 0;
+		ALERT( at_console, "Lost Coast: AI node graph %s: %d nodes, %d links (in ARAM)\n", file, g_lcNumNodes, g_lcNumLinks );
+		return;
+	}
 	d = LOAD_FILE_FOR_ME( (char *)file, &len );
 	if( !d )
 		return;
@@ -527,9 +569,16 @@ static int LC_Route( const Vector &from, const Vector &to, Vector *out, int maxo
 	static float g[LC_MAX_NODES], f[LC_MAX_NODES];
 	static short prev[LC_MAX_NODES];
 	static char state[LC_MAX_NODES]; // 0 new, 1 open, 2 closed
-	int s = LC_NearestNode( from ), e = LC_NearestNode( to ), i, n = 0;
+	byte graph[LC_GRAPH_MAX + 32] __attribute__(( aligned( 32 )));
+	int s, e, i, n = 0;
 	short path[LC_MAX_NODES];
 
+	LC_GraphOpen( graph );
+	if( !g_lcNodes )
+		return 0;
+	s = LC_NearestNode( from );
+	e = LC_NearestNode( to );
+
 	if( s < 0 || e < 0 )
 		return 0;
 	for( i = 0; i < g_lcNumNodes; i++ )
@@ -560,6 +609,8 @@ static int LC_Route( const Vector &from, const Vector &to, Vector *out, int maxo
 			int o;
 			float c;
 
+			if( g_lcLinks[i][0] >= g_lcNumNodes || g_lcLinks[i][1] >= g_lcNumNodes )
+				continue; // a link to a node that is not there
 			if( g_lcLinks[i][0] == cur )
 				o = g_lcLinks[i][1];
 			else if( g_lcLinks[i][1] == cur )
@@ -762,12 +813,13 @@ void CLCFisherman::KeyValue( KeyValueData *pkvd )
 
 void CLCFisherman::Precache( void )
 {
-	PRECACHE_MODEL( STRING( pev->model ));
-	// The node graph first: its file is 8 KB in one piece, and after the
-	// scenes have taken their strings the GameCube heap no longer has that
-	// (he then walked every route in a straight line).
+	// The node graph before anything else of his: its file is 8 KB in one
+	// piece and stays loaded, and the GameCube heap only has that much in
+	// one piece before his model and scenes have taken theirs (without it
+	// he walked every route in a straight line).
 	if( !FStringNull( m_iszNodes ))
 		LC_LoadNodes( STRING( m_iszNodes ));
+	PRECACHE_MODEL( STRING( pev->model ));
 	if( !FStringNull( m_iszScene ))
 		LC_LoadScene( STRING( m_iszScene ));
 	if( !FStringNull( m_iszGateScene ))
@@ -1163,7 +1215,15 @@ void CLCFisherman::RunScene( float interval )
 			}
 			break;
 		case LCE_BODY:
-			pev->body = (int)ev->a;
+			// bits of his body: 1 his weapon is gone, 2 a prop is in his
+			// hand; a negative number clears those bits
+			if( !ev->started )
+			{
+				if( ev->a < 0 )
+					pev->body &= ~(int)( -ev->a );
+				else
+					pev->body |= (int)ev->a;
+			}
 			break;
 		case LCE_HINGE:
 			if( !ev->started )
-- 
