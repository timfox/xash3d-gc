diff --git a/dlls/skill.h b/dlls/skill.h
index 3b95e8a3..f6f6add8 100644
--- a/dlls/skill.h
+++ b/dlls/skill.h
@@ -141,6 +141,10 @@ struct skilldata_t
 	float plrStomach;
 	float plrLeg;
 	float plrArm;
+
+	// story mode (skill 0): scale on all non-drowning damage the player takes.
+	// 1.0 on skills 1-3, so retail difficulties are unchanged.
+	float plrDmgTakenScale;
 };
 
 extern	DLL_GLOBAL	skilldata_t	gSkillData;
@@ -148,6 +152,9 @@ float GetSkillCvar( const char *pName );
 
 extern DLL_GLOBAL int		g_iSkillLevel;
 
+// Skill 0 is a story mode below Easy, like Quake's skill 0. It plays with the
+// skill 1 (Easy) values and Easy behaviour, then softens them further.
+#define SKILL_STORY		0
 #define SKILL_EASY		1
 #define SKILL_MEDIUM	2
 #define SKILL_HARD		3
