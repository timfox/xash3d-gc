+//=========================================================
+// monster_lc_soldier: a Combine soldier the map keeps in a point_template
+// until a trigger_once or trigger_look ForceSpawns his squad (the cliff
+// path's first squads). He stands hidden at his template spot until then;
+// lc_spawn is the trigger (as the fisherman's lc_cueN, without a scene),
+// lc_squad the template's name. For now he appears and stands at idle:
+// his AI is the next step.
+//=========================================================
+class CLCSoldier : public CBaseAnimating
+{
+public:
+	void Spawn( void );
+	void Precache( void ) { PRECACHE_MODEL( STRING( pev->model )); }
+	void KeyValue( KeyValueData *pkvd );
+	void EXPORT SoldierThink( void );
+	int ObjectCaps( void ) { return FCAP_DONT_SAVE; }
+private:
+	lc_cue_t	m_spawn;
+	BOOL		m_bHaveSpawn, m_bOut;
+	string_t	m_iszSquad;
+	float		m_flTest;
+};
+LINK_ENTITY_TO_CLASS( monster_lc_soldier, CLCSoldier )
+
+void CLCSoldier::KeyValue( KeyValueData *pkvd )
+{
+	if( FStrEq( pkvd->szKeyName, "lc_spawn" ))
+	{
+		m_bHaveSpawn = LC_ParseCue( &m_spawn, pkvd->szValue, NULL, 0 );
+		pkvd->fHandled = TRUE;
+	}
+	else if( FStrEq( pkvd->szKeyName, "lc_squad" ))
+	{
+		m_iszSquad = ALLOC_STRING( pkvd->szValue );
+		pkvd->fHandled = TRUE;
+	}
+	else
+		CBaseAnimating::KeyValue( pkvd );
+}
+
+void CLCSoldier::Spawn( void )
+{
+	Precache();
+	SET_MODEL( ENT( pev ), STRING( pev->model ));
+	UTIL_SetSize( pev, Vector( -13, -13, 0 ), Vector( 13, 13, 72 ));
+	pev->solid = SOLID_NOT;
+	pev->movetype = MOVETYPE_NONE;
+	pev->takedamage = DAMAGE_NO;
+	pev->effects |= EF_NODRAW;	// in the template until his squad is spawned
+	pev->sequence = LookupSequence( "idle" );
+	if( pev->sequence < 0 )
+		pev->sequence = 0;
+	pev->frame = 0;
+	pev->framerate = 1.0f;
+	ResetSequenceInfo();
+	// A probe with nobody at the controls: the squad comes out by itself.
+	m_flTest = LC_BootSwitch( "lcsquadtest" ) ? gpGlobals->time + 3.0f : 0.0f;
+	SetThink( &CLCSoldier::SoldierThink );
+	pev->nextthink = gpGlobals->time + 0.2f;
+}
+
+void CLCSoldier::SoldierThink( void )
+{
+	pev->nextthink = gpGlobals->time + ( m_bOut ? 0.1f : 0.2f );
+	if( m_bOut )
+	{
+		StudioFrameAdvance();
+		return;
+	}
+	CBaseEntity *pl = UTIL_PlayerByIndex( 1 );
+
+	if( m_flTest > 0 && gpGlobals->time >= m_flTest )
+		m_spawn.pending = TRUE;
+	else if( m_bHaveSpawn && pl && !m_spawn.done && !m_spawn.pending && LC_CueWatch( &m_spawn, pl ))
+		return; // timed out: his squad stays in the template
+	if( !m_spawn.pending )
+		return;
+	m_bOut = TRUE;
+	pev->effects &= ~EF_NODRAW;
+	pev->solid = SOLID_BBOX;
+	UTIL_SetOrigin( pev, pev->origin );
+	pev->animtime = gpGlobals->time;
+	ALERT( at_console, "Lost Coast: soldier of %s spawns at %.0f %.0f %.0f\n",
+		FStringNull( m_iszSquad ) ? "?" : STRING( m_iszSquad ), pev->origin.x, pev->origin.y, pev->origin.z );
+}
