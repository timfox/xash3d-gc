+// A trigger_once box, or a trigger_look (box + look target), from the bake:
+// sets c->pending once it fires. TRUE when a look trigger has timed out
+// (Source fires OnTimeout then, which this map connects to nothing).
+static BOOL LC_CueWatch( lc_cue_t *c, CBaseEntity *pl )
+{
+	float now = gpGlobals->time;
+	const Vector &o = pl->pev->origin;
+	BOOL in = o.x >= c->box[0] && o.y >= c->box[1] && o.z >= c->box[2] - 36
+		&& o.x <= c->box[3] && o.y <= c->box[4] && o.z <= c->box[5] + 36;
+
+	if( !in )
+		c->touched = c->looked = 0.0f;
+	else if( c->fov <= 0.0f )
+		c->pending = TRUE;
+	else
+	{
+		Vector eye = o + pl->pev->view_ofs;
+		Vector d = ( Vector( c->look[0], c->look[1], c->look[2] ) - eye ).Normalize();
+
+		if( c->touched == 0.0f )
+			c->touched = now;
+		if( c->timeout > 0 && now - c->touched > c->timeout )
+		{
+			c->done = TRUE; // OnTimeout
+			ALERT( at_console, "Lost Coast: look trigger at %.0f %.0f %.0f timed out\n", c->look[0], c->look[1], c->look[2] );
+			return TRUE;
+		}
+		UTIL_MakeVectors( pl->pev->v_angle );
+		if( DotProduct( d, gpGlobals->v_forward ) < c->fov )
+			c->looked = 0.0f;
+		else if( c->looked == 0.0f )
+			c->looked = now;
+		else if( now - c->looked >= c->looktime )
+			c->pending = TRUE;
+	}
+	return FALSE;
+}
+
+static int LC_ParseCue( lc_cue_t *c, const char *v, char *scene, int scene_max )
+{
+	float *b = c->box;
+	char fmt[96];
+
+	memset( c, 0, sizeof( *c ));
+	if( scene )
+		snprintf( fmt, sizeof( fmt ), "%%f %%f %%f %%f %%f %%f %%%ds %%f %%f %%f %%f %%f %%f", scene_max - 1 );
+	int n = scene ? sscanf( v, fmt, &b[0], &b[1], &b[2], &b[3], &b[4], &b[5], scene,
+			&c->look[0], &c->look[1], &c->look[2], &c->fov, &c->looktime, &c->timeout ) - 1
+		: sscanf( v, "%f %f %f %f %f %f %f %f %f %f %f %f", &b[0], &b[1], &b[2], &b[3], &b[4], &b[5],
+			&c->look[0], &c->look[1], &c->look[2], &c->fov, &c->looktime, &c->timeout );
+	if( n == 6 )
+		c->fov = 0.0f; // a plain trigger_once
+	return n == 6 || n == 12;
+}
